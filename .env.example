# Anthropic API key: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Optional: override the default model used by all agents
# ANTHROPIC_MODEL=claude-sonnet-4-6

# Postgres connection for run/agent-event/report history (api/ module).
# Falls back to a local default if unset; set this for real use.
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/growth_agent_orchestrator

# api/main.py: shared PIN required to sign in, and the key used to sign the
# session cookie. Both required — pick a real PIN and a long random string
# (e.g. `python -c "import secrets; print(secrets.token_hex(32))"`).
APP_PIN=
SESSION_SECRET_KEY=
